{
  "schemaVersion": "1.0.0",
  "collection": "ai_conversations",
  "purpose": "Project-scoped Ollama chat turns, isolated by project membership and user.",
  "required": ["type", "projectId", "userEmail", "question", "answer", "createdAt"],
  "properties": {
    "type": { "type": "string", "enum": ["project_chat_turn"] },
    "projectId": { "type": "string" },
    "userEmail": { "type": "string", "format": "email" },
    "question": { "type": "string", "maxLength": 2000 },
    "answer": { "type": "string", "maxLength": 4000 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "indexes": [
    { "keys": { "userEmail": 1, "projectId": 1, "type": 1, "createdAt": -1 } }
  ]
}
