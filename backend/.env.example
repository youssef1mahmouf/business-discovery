PORT=3000
TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_ORIGIN=https://youssef1mahmouf.github.io/business-discovery/
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=business_discovery
JSON_FALLBACK_DIR=backend/data/fallback
NODE_ENV=development
ACCESS_TOKEN_TTL_SECONDS=900
# Email delivery for password-recovery codes.
# For Brevo, set EMAIL_PROVIDER=brevo and create an API key in the Brevo account.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Business Discovery
# Optional SMTP settings; required to deliver password-recovery codes.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASS=YOUR_BREVO_SMTP_KEY
SMTP_FROM=your-verified-email@yourdomain.com
# Local Ollama is required for project recommendations and PDF/DOCX extraction.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=45000
# Optional one-time administrator provisioning (never commit real values):
# ADMIN_EMAIL=
# ADMIN_PROVISION_CONFIRM=yes
